#:kivy 2.3.0

<MainScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.theme_cls.backgroundColor

        MDBoxLayout:
            orientation: "horizontal"
            adaptive_height: True
            padding: ["16dp", "12dp", "16dp", "12dp"]
            spacing: "12dp"
            md_bg_color: app.theme_cls.surfaceContainerColor

            MDLabel:
                text: "Modbus HMI"
                font_style: "Title"
                role: "large"
                adaptive_width: True
                pos_hint: {"center_y": .5}

            Widget:

            MDTextField:
                id: server_ip
                text: "127.0.0.1"
                hint_text: "IP Servidor"
                mode: "outlined"
                size_hint_x: None
                width: "140dp"
                pos_hint: {"center_y": .5}

            MDTextField:
                id: server_port
                text: "51020"
                hint_text: "Porta"
                mode: "outlined"
                size_hint_x: None
                width: "80dp"
                pos_hint: {"center_y": .5}

            MDButton:
                style: "filled"
                pos_hint: {"center_y": .5}
                on_release: root.toggle_connection(server_ip.text, server_port.text)
                md_bg_color: [0.2, 0.7, 0.3, 1] if root.is_connected else app.theme_cls.primaryColor

                MDButtonIcon:
                    icon: "check-circle-outline" if root.is_connected else "connection"

                MDButtonText:
                    text: "Conectado" if root.is_connected else "Conectar"

        MDBoxLayout:
            orientation: "vertical"
            padding: "24dp"
            spacing: "16dp"

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_height: True
                spacing: "12dp"

                MDTextField:
                    id: modbus_type
                    text: "Holding Register"
                    hint_text: "Tipo (Coil / Holding Register / Float)"
                    mode: "outlined"
                    size_hint_x: 0.6

                MDTextField:
                    id: reg_address
                    text: "0"
                    hint_text: "Endereço Modbus"
                    mode: "outlined"
                    size_hint_x: 0.4

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_height: True
                spacing: "12dp"

                MDCheckbox:
                    id: cyclic_check
                    active: False
                    size_hint: None, None
                    size: "48dp", "48dp"
                    pos_hint: {"center_y": .5}
                    on_active: root.on_cyclic_toggle(self.active)

                MDLabel:
                    text: "Leitura Recorrente"
                    adaptive_width: True
                    pos_hint: {"center_y": .5}

                MDTextField:
                    id: scan_interval
                    text: "1.0"
                    hint_text: "Intervalo (s)"
                    mode: "outlined"
                    size_hint_x: None
                    width: "100dp"
                    pos_hint: {"center_y": .5}

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_height: True
                spacing: "12dp"

                MDButton:
                    style: "filled"
                    on_release: root.executar_leitura()
                    pos_hint: {"center_y": .5}
                    MDButtonText:
                        text: "Ler Dados"

                MDLabel:
                    text: "Valor Lido: " + root.read_result
                    font_style: "Title"
                    role: "medium"
                    pos_hint: {"center_y": .5}

            Widget:
                size_hint_y: None
                height: "2dp"
                md_bg_color: app.theme_cls.surfaceContainerHighestColor

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_height: True
                spacing: "12dp"

                MDTextField:
                    id: write_value
                    hint_text: "Valor para Escrever"
                    mode: "outlined"
                    size_hint_x: 0.6
                    pos_hint: {"center_y": .5}

                MDButton:
                    style: "filled"
                    on_release: root.executar_escrita(write_value.text)
                    pos_hint: {"center_y": .5}
                    MDButtonText:
                        text: "Escrever"

            Widget:
